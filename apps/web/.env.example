# Copy to .env.local for development. These three values are PUBLIC by design (they ship to the browser):
# never put a service-role key, database URL, R2 key or RunPod key in this app.
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key
