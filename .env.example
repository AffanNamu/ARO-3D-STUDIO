# ARO API configuration (aro_cloud). Copy to a PRIVATE file or, better, set these in your host's secret store.
# NEVER commit real values. Every variable is documented in docs/platform/owner-setup.md.

ARO_ENV=development                      # production | development | test   (production refuses to start with anything missing)

# --- Supabase ---------------------------------------------------------------------------------------------------------------------
ARO_DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres   # SECRET, server-side only
ARO_DATABASE_SSL=auto                    # auto | verify | require | disable
ARO_SUPABASE_URL=https://PROJECT.supabase.co
# ARO_SUPABASE_JWT_SECRET=               # SECRET: only for legacy projects that still sign tokens with a shared HS256 secret

# --- Cloudflare R2 ----------------------------------------------------------------------------------------------------------------
ARO_R2_ACCOUNT_ID=
ARO_R2_BUCKET=
ARO_R2_ACCESS_KEY_ID=                    # SECRET
ARO_R2_SECRET_ACCESS_KEY=                # SECRET

# --- RunPod Serverless ------------------------------------------------------------------------------------------------------------
ARO_RUNPOD_API_KEY=                      # SECRET
ARO_RUNPOD_ENDPOINT_ID=

# --- API behaviour ----------------------------------------------------------------------------------------------------------------
ARO_ALLOWED_ORIGINS=http://localhost:3000   # comma-separated web origins (CORS)
ARO_INTERNAL_TOKEN=                      # SECRET, 24+ random characters; protects POST /internal/reconcile
ARO_ENABLED_ENGINES=triposg              # engines requests may name; each ALSO has to be verified and enabled in the database by a person
ARO_PRICE_IMAGE_TO_3D=10                 # credits per generation
ARO_SIGNUP_CREDITS=0                     # free credits on first sign-in (0 = none)
ARO_GPU_USD_PER_SECOND=                  # your RunPod price for the chosen GPU, to record a cost estimate per job (empty = none recorded)
