# Copy to .env (local) or set as Space/host secrets. NEVER commit real values.
ARO_DATA_DIR=data
# Optional: require `Authorization: Bearer <token>` on every API call. Strongly recommended on a public Space.
# ARO_ACCESS_TOKEN=change-me
ARO_DEVICE=auto                  # auto | cpu | cuda | cuda:0
ARO_DEFAULT_ENGINE=triposr
# Local path or Hugging Face repo id of the TripoSR weights (pin a revision in production)
ARO_TRIPOSR_MODEL_PATH=stabilityai/TripoSR
# Comma-separated engine ids whose WEIGHTS licence you have personally verified (see docs/models/model-licenses.md)
# ARO_VERIFIED_MODEL_LICENSES=triposr
# Only needed for gated/private weights; keep as a secret, never in the repo
# ARO_HF_TOKEN=
ARO_MAX_UPLOAD_MB=25
ARO_MAX_IMAGE_PIXELS=64000000
ARO_JOB_TIMEOUT_S=1800
ARO_WORKERS=1
ARO_MODEL_IDLE_UNLOAD_S=300
ARO_TRI_BUDGET_LOD0=150000
ARO_LOG_LEVEL=INFO
